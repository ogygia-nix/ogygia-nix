#~flake path:@dir(root)#x
#~tree dep store
#~file flake.nix
{ nixConfig.a = 1 + 1; outputs = _: { v = 1; }; }
#~tree root path
#~file flake.nix
{ inputs.dep.url = "github:someone/dep"; outputs = { self, dep }: { x = dep.v; }; }
#~file flake.lock
{
  "nodes": {
    "dep": {
      "locked": { "lastModified": 1700000000, "narHash": "@narHash(dep)", "owner": "someone", "repo": "dep", "rev": "0123456789abcdef0123456789abcdef01234567", "type": "github" },
      "original": { "owner": "someone", "repo": "dep", "type": "github" }
    },
    "root": { "inputs": { "dep": "dep" } }
  },
  "root": "root",
  "version": 7
}
