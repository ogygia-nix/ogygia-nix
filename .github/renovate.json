{
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions", "nix"],
      "automerge": true
    },
    {
      "matchManagers": ["cargo"],
      "rangeStrategy": "replace"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9.]+(?:-arm)?)\\s+# renovate: github-runner"
      ],
      "datasourceTemplate": "github-runners"
    }
  ],
  "rebaseWhen": "conflicted",
  "schedule": ["after 11pm on Monday"],
  "extends": [
    ":semanticCommits",
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ]
}

