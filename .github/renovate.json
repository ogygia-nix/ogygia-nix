{
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions", "nix"],
      "automerge": true
    }
  ],
  "rebaseWhen": "conflicted",
  "schedule": ["after 11pm on Monday"],
  "extends": [
    ":semanticCommits",
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ]
}

